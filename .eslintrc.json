{
  "extends": ["react-app", "prettier"],
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    },
    "requireConfigFile": true
  },
  "env": {
    "browser": true,
    "es6": true,
    "webextensions": true,
    "node": true
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": "warn",
    "react/prop-types": "off",
    "prefer-const": "warn"
  },
  "overrides": [
    {
      "files": ["src/**/*.{js,jsx,ts,tsx}"],
      "rules": {
        "no-var": "error"
      }
    },
    {
      "files": ["**/injected.js"],
      "rules": {
        "strict": "off"
      }
    },
    {
      "files": ["utils/**/*.js", "webpack.config.js"],
      "parserOptions": {
        "sourceType": "script"
      },
      "rules": {
        "no-var": "off",
        "no-unused-vars": "off"
      }
    }
  ]
}
